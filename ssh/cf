#!/bin/bash
apt update -y && apt install -y jq curl

sub=$(</dev/urandom tr -dc a-z0-9 | head -c5)
DOMAIN="mahboubvps.site"
SUB_DOMAIN="asx-${sub}.${DOMAIN}"
CF_TOKEN="XOYA63kolRF-6_EzxZQ22ESucCdm7zSJl7NEDQtA"
ZONE="8761c8222fe8a4d1249e8563eedf43ee"
IP=$(curl -s ipv4.icanhazip.com)

echo "[*] Server IP: $IP"
echo "[*] Subdomain to create: $SUB_DOMAIN"

RESPONSE=$(curl -sLX GET "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records?name=${SUB_DOMAIN}" \
  -H "Authorization: Bearer ${CF_TOKEN}" \
  -H "Content-Type: application/json")

RECORD_ID=$(echo "$RESPONSE" | jq -r '.result[0].id')

if [[ -z "$RECORD_ID" || "$RECORD_ID" == "null" ]]; then
  echo "[*] Creating A record..."
  CREATE_RESPONSE=$(curl -sLX POST "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records" \
    -H "Authorization: Bearer ${CF_TOKEN}" \
    -H "Content-Type: application/json" \
    --data "{\"type\":\"A\",\"name\":\"${SUB_DOMAIN}\",\"content\":\"${IP}\",\"ttl\":120,\"proxied\":false}")
else
  echo "[*] Updating A record..."
  UPDATE_RESPONSE=$(curl -sLX PUT "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records/${RECORD_ID}" \
    -H "Authorization: Bearer ${CF_TOKEN}" \
    -H "Content-Type: application/json" \
    --data "{\"type\":\"A\",\"name\":\"${SUB_DOMAIN}\",\"content\":\"${IP}\",\"ttl\":120,\"proxied\":false}")
fi

# Add NS Record
NS_TARGET="dns.${DOMAIN}"
echo "[*] Creating NS record: ${SUB_DOMAIN} → ${NS_TARGET}"

NS_RESPONSE=$(curl -sLX POST "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records" \
  -H "Authorization: Bearer ${CF_TOKEN}" \
  -H "Content-Type: application/json" \
  --data "{\"type\":\"NS\",\"name\":\"${SUB_DOMAIN}\",\"content\":\"${NS_TARGET}\",\"ttl\":120,\"proxied\":false}")

echo "[DEBUG] NS Response: $NS_RESPONSE"

mkdir -p /etc/xray /etc/v2ray /root/xray
echo "$SUB_DOMAIN" | tee /root/domain /etc/xray/domain /etc/v2ray/domain /root/scdomain /root/xray/scdomain > /dev/null
echo "IP=$SUB_DOMAIN" > /var/lib/ipvps.conf

echo "✅ Domain Setup Completed"
echo "🔹 A Record: $SUB_DOMAIN → $IP"
echo "🔹 NS Record: $SUB_DOMAIN → $NS_TARGET"
